# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Your MongoDB Atlas connection string (include the db name, e.g. /staffflow)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/staffflow?retryWrites=true&w=majority&appName=Cluster0

# ---- Auth ----
# Use a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed frontend origins (your Vercel URL + localhost)
CLIENT_ORIGINS=http://localhost:3000

# ---- Seed (optional defaults used by src/seed.js) ----
SEED_MANAGER_EMAIL=manager@staffflow.com
SEED_MANAGER_PASSWORD=Manager@123
SEED_EMPLOYEE_EMAIL=employee@staffflow.com
SEED_EMPLOYEE_PASSWORD=Employee@123
